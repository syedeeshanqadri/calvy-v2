# Copy to .env.local and fill in. Never commit real values.

# --- Required in production ---
# PostgreSQL connection string (pooled)
DATABASE_URL=
# Neon direct (non-pooler) URL, used by migrations
DIRECT_URL=
# Random string used to sign NextAuth JWTs
NEXTAUTH_SECRET=

# --- URLs ---
# Public base URL of the app (NextAuth)
NEXTAUTH_URL=http://localhost:3000
# Public base URL used in emails/links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for tenant subdomains (e.g. calvy.io)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Admin ---
# Email of the super admin account
SUPER_ADMIN_EMAIL=
# Secret guarding the one-off admin setup route
ADMIN_SETUP_SECRET=
# Bearer token for /api/cron/notifications (Vercel Cron and cron-job.org; required in production)
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Sender, e.g. Calvy <bookings@yourdomain.com>
EMAIL_FROM=
# Where form notifications (new lead / signup / onboarding) are sent; defaults to the support address
NOTIFY_EMAIL=

# --- OAuth login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# WhatsApp: each business connects its own WhatsApp Business Account in Settings; credentials are stored encrypted in the DB (docs/whatsapp-setup.md).

# --- Vercel Blob (uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- S3-compatible storage (Cloudflare R2): tenant uploads in production ---
# Driver is s3 in production, local disk (public/uploads) in development.
# STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket
S3_PUBLIC_URL=

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push providers
VAPID_SUBJECT=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET=
# Razorpay plan ids for subscriptions
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_BUSINESS=

# --- Database tooling ---
# Throwaway database used by prisma migrate dev (never the real one)
SHADOW_DATABASE_URL=

# --- Upstash Redis (distributed rate limiting; planned) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
