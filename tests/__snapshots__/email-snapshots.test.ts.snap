table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">For</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">Aarav Kapoor (booked by Riya Kapoor)</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">With</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">Dr Rao</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Date</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">Mon, 2 Nov</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Time</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">10:00 AM</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Duration</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">30 min</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Price</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">₹500</td></tr></tbody></table></td></tr></tbody></table><p style="font-size:15px;line-height:24px;color:#6b6b80;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">You are now number <!-- -->3<!-- --> in line. You get four calls in all: if you are not present for the fourth, this <!-- -->appointment<!-- --> is closed and what you paid is saved in your wallet.</p><table width="100%" style="margin:8px 0 4px"><tbody><tr><td><a href="https://x.test/track/a1" style="display:inline-block;background-color:#0f766e;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border-radius:12px">Track your place in line</a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><p style="font-size:12px;line-height:18px;text-align:center;color:#6b6b80;margin-top:20px;margin-bottom:16px">Sunrise  ·  1 Main St  ·  +91 98765 43210<br/>Want a site like this?<!-- --> <a href="https://calvy.io" style="color:#6b6b80;text-decoration-line:none;text-decoration:underline" target="_blank">Grab it on Calvy</a></p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
