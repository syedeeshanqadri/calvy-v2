nt-size:14px;font-weight:600">Mon, 2 Nov</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Time</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">10:00 AM</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Duration</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">30 min</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Price</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">₹500</td></tr></tbody></table></td></tr></tbody></table><table width="100%" style="margin:8px 0 4px"><tbody><tr><td><a href="https://x.test/sunrise" style="display:inline-block;background-color:#0284c7;color:#fff;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border-radius:12px">Book again</a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><p style="font-size:12px;line-height:18px;text-align:center;color:#6b6b80;margin-top:20px;margin-bottom:16px">Calvy · Smart appointment booking<br/><a href="https://calvy.io" style="color:#6b6b80;text-decoration-line:none;text-decoration:underline" target="_blank">calvy.io</a>  ·  <a href="https://calvy.io/help" style="color:#6b6b80;text-decoration-line:none;text-decoration:underline" target="_blank">Help Center</a></p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
