<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#0f0f1a;padding:20px 28px"><tbody><tr><td><p style="font-size:20px;line-height:24px;color:#0284c7;font-weight:700;margin:0;letter-spacing:-0.2px;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">● Calvy</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:32px 28px"><tbody><tr><td><span style="display:inline-block;background-color:#e7f7ec;color:#16a34a;font-size:12px;font-weight:700;padding:4px 12px;border-radius:999px">Confirmed</span><p style="font-size:22px;line-height:24px;font-weight:700;color:#0f0f1a;margin:0 0 8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">You&#x27;re booked</p><p style="font-size:15px;line-height:24px;color:#6b6b80;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hi <!-- -->Riya<!-- -->, your <!-- -->appointment<!-- --> at <strong style="color:#0f0f1a">Sunrise</strong> is confirmed. Here are the details:</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#f4f4f1;border-radius:12px;padding:18px 20px;margin:4px 0 8px"><tbody><tr><td><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Service</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">Checkup</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">For</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">Aarav Kapoor (booked by Riya Kapoor)</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">With</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">Dr Rao</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Format</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">Online consultation</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Date</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">Mon, 2 Nov</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Time</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">10:00 AM</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Duration</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:600">30 min</td></tr></tbody></table><table width="100%" style="margin:0 0 8px"><tbody><tr><td style="color:#6b6b80;font-size:14px">Price</td><td style="text-align:right;color:#0f0f1a;font-size:14px;font-weight:700">₹500</td></tr></tbody></table></td></tr></tbody></table><p style="font-size:15px;line-height:24px;color:#6b6b80;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">This is an online consultation. Join from the link below at your appointment time; it works on your phone or computer.</p><table width="100%" style="margin:8px 0 4px"><tbody><tr><td><a href="https://meet.test/abc" style="display:inline-block;background-color:#0284c7;color:#fff;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border-radius:12px">Join the consultation</a></td></tr></tbody></table><p style="font-size:15px;line-height:24px;color:#6b6b80;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">We&#x27;ve added this to your calendar (see the attachment). See you soon.</p></td></tr></tbody></table></td></tr></tbody></table><p style="font-size:12px;line-height:18px;text-align:center;color:#6b6b80;margin-top:20px;margin-bottom:16px">Calvy · Smart appointment booking<br/><a href="https://calvy.io" style="color:#6b6b80;text-decoration-line:none;text-decoration:underline" target="_blank">calvy.io</a>  ·  <a href="https://calvy.io/help" style="color:#6b6b80;text-decoration-line:none;text-decoration:underline" target="_blank">Help Center</a></p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
