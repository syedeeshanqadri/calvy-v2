generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String? // null for OAuth-only accounts (Google/Facebook)
  /// Google account id (profile.sub). Set only on a verified Google sign-up or an explicit "Link Google" by the logged-in owner; never linked silently by email.
  googleId            String?              @unique
  /// Calvy super admin. Set ONLY by `npm run admin:grant` (never by any page or API).
  isSuperAdmin        Boolean              @default(false)
  /// Authenticator-app secret, encrypted (lib/notifications/secret). Null until the admin enrolls.
  adminTotpSecret     String?
  adminTotpEnabledAt  DateTime?
  /// The last TOTP time-step accepted, so a code cannot be used twice.
  adminTotpLastStep   Int?
  /// SHA-256 hashes of the unused one-time recovery codes (shown once, at enrollment).
  adminRecoveryHashes String[]             @default([])
  image               String?
  role                String               @default("user")
  emailVerified       DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business?
  teamMember          TeamMember?
  pushDevices         PushDevice[]
  pushPreference      PushPreference?
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Written once by the auth_lifecycle migration: groups of records whose emails
// collide when lowercased. Rows are only flagged, never merged or deleted.
model EmailDuplicateReport {
  id              String   @id @default(cuid())
  entity          String
  normalizedEmail String
  recordIds       String[]
  businessId      String?
  detectedAt      DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Business {
  id                       String              @id @default(cuid())
  name                     String
  slug                     String              @unique
  plan                     String              @default("free")
  planStatus               String              @default("free")
  trialEndsAt              DateTime?
  razorpayCustomerId       String?             @unique
  razorpaySubscriptionId   String?
  ownerId                  String              @unique
  businessType             String              @default("general")
  packId                   PackId              @default(OTHER)
  /// "IN" or "INTL"; picked in the onboarding wizard (drives currency and which price list is shown).
  region                   String              @default("INTL")
  /// Wizard progress: the step to show next (1..8). Saved per step so the wizard resumes.
  onboardingStep           Int                 @default(1)
  /// Null until the wizard is finished. Existing businesses were stamped by the migration.
  onboardingCompletedAt    DateTime?
  /// The plan the owner showed interest in during the wizard. Everyone starts on Free (subscriptions are parked).
  intendedPlan             String?
  bookingMode              BookingMode         @default(SLOT)
  onlinePayMode            OnlinePayMode       @default(BOOKING_FEE_ONLY)
  feePayer                 FeePayer            @default(CUSTOMER)
  termsOverride            Json?
  phone                    String?
  email                    String?
  address                  String?
  website                  String?
  description              String?
  primaryColor             String              @default("#e84545")
  logoUrl                  String?
  socialLinks              Json?
  googleReviewUrl          String?
  /// Notification switches (lib/notifications/prefs.ts). Null = every default.
  notificationPrefs        Json?
  availabilityJson         String              @default("{}")
  currency                 String              @default("USD")
  paymentMode              String              @default("postpaid")
  bankAccountName          String?
  bankAccountNumber        String?
  bankRoutingNumber        String?
  bankIban                 String?
  razorpayConnectAccountId String?
  // Razorpay Route (linked account) onboarding
  razorpayStakeholderId    String?
  razorpayRouteProductId   String?
  routeStatus              String              @default("not_started") // not_started | created | needs_clarification | activated
  legalBusinessName        String?
  rzpBusinessType          String? // proprietorship | partnership | private_limited | public_limited | llp | individual ...
  rzpCategory              String? // Razorpay profile category, e.g. "healthcare"
  rzpSubcategory           String? // Razorpay profile subcategory
  panNumber                String?
  gstNumber                String?
  addressStreet            String?
  addressCity              String?
  addressState             String?
  addressPostalCode        String?
  websiteJson              String              @default("{}")
  slotInterval             Int                 @default(30)
  timezone                 String              @default("Asia/Kolkata")
  minNoticeMinutes         Int                 @default(0)
  maxAdvanceDays           Int                 @default(90)
  /// Fair use: most different people one booker contact can book for per day (per session for tokens).
  maxPeoplePerBooker       Int                 @default(4)
  cancellationCutoffHours  Int                 @default(0)
  /// Days after a completed appointment during which one free follow-up with the same doctor is allowed. 0 = off.
  followUpDays             Int                 @default(0)
  /// Set by a Calvy admin: no NEW bookings; existing bookings and reminders carry on.
  suspendedAt              DateTime?
  suspendedReason          String?
  /// Calvy admin plan override. While set, `plan`/`planStatus` hold the override and these remember what to go back to.
  /// The cron (and getBusinessFeatures) put the original back at the end date; until null = until an admin clears it.
  planOverridePlan         String?
  planOverrideUntil        DateTime?
  planOverrideFromPlan     String?
  planOverrideFromStatus   String?
  workingHours             WorkingHours[]
  timeOff                  TimeOff[]
  tokenSessions            TokenSession[]
  payments                 Payment[]
  customerCredits          CustomerCredit[]
  platformFees             PlatformFeeEntry[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  appointments             Appointment[]
  owner                    User                @relation(fields: [ownerId], references: [id])
  clients                  Client[]
  services                 Service[]
  staff                    Staff[]
  withdrawalRequests       WithdrawalRequest[]
  pushDevices              PushDevice[]
  broadcasts               Broadcast[]
  expenses                 Expense[]
  notifications            Notification[]
  supportTickets           SupportTicket[]
  teamMembers              TeamMember[]
}

model Staff {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  role           String
  email          String
  phone          String?
  color          String         @default("#e84545")
  isActive       Boolean        @default(true)
  /// Default video-call link for this person's online consultations (https). Never shown before booking.
  meetingUrl     String?
  /// Website team card (lib/siteSections.ts caps): photo URL, short bio, specialisation.
  photoUrl       String?
  bio            String?
  specialisation String?
  workingHours   String         @default("{}")
  createdAt      DateTime       @default(now())
  appointments   Appointment[]
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services       StaffService[]
  hours          WorkingHours[]
  timeOff        TimeOff[]
  tokenSessions  TokenSession[]
}

model Service {
  id              String         @id @default(cuid())
  businessId      String
  name            String
  description     String         @default("")
  duration        Int
  price           Float
  category        String         @default("other")
  color           String         @default("#e84545")
  capacity        Int            @default(1)
  /// In person, online or both. Online bookings get a meeting link (service override, else the staff member's).
  mode            ServiceMode    @default(IN_PERSON)
  /// Optional per-service meeting link; overrides the staff member's. Never shown before booking.
  meetingUrl      String?
  bufferBeforeMin Int            @default(0)
  bufferAfterMin  Int            @default(0)
  /// Optional image for the website's image-card layout.
  imageUrl        String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  appointments    Appointment[]
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff           StaffService[]
}

model StaffService {
  staffId   String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Client {
  id                String           @id @default(cuid())
  businessId        String
  name              String
  email             String?
  phone             String?
  notes             String?
  totalAppointments Int              @default(0)
  totalSpent        Float            @default(0)
  lastVisit         DateTime?
  createdAt         DateTime         @default(now())
  appointments      Appointment[]
  credits           CustomerCredit[]
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@index([businessId])
}

model PlanConfig {
  planId                 String   @id
  name                   String
  price                  Float
  annualPrice            Float    @default(0)
  description            String
  maxStaff               Int
  maxServices            Int
  maxMonthlyAppointments Int
  maxBroadcastsPerMonth  Int      @default(0)
  /// Team logins besides the owner (-1 = unlimited, 0 = owner only).
  maxTeamMembers         Int      @default(0)
  /// Calvy platform fee per public online booking in India, in paise (Free = 1000, paid plans = 0).
  platformFeeMinorIN     Int      @default(0)
  // Feature flags
  analytics              Boolean  @default(false)
  customBranding         Boolean  @default(false)
  imageUpload            Boolean  @default(false)
  seoControls            Boolean  @default(false)
  chatbotWidget          Boolean  @default(false)
  groupBooking           Boolean  @default(false)
  multiService           Boolean  @default(true)
  stripePayments         Boolean  @default(false)
  emailReminders         Boolean  @default(false)
  smsReminders           Boolean  @default(false)
  broadcasts             Boolean  @default(false)
  csvExport              Boolean  @default(false)
  expenseTracking        Boolean  @default(false)
  wallet                 Boolean  @default(false)
  customSlotInterval     Boolean  @default(false)
  removeBranding         Boolean  @default(false)
  prioritySupport        Boolean  @default(false)
  features               String   @default("[]")
  updatedAt              DateTime @updatedAt
}

model Appointment {
  id                 String             @id @default(cuid())
  businessId         String
  clientId           String
  staffId            String?
  serviceId          String
  date               DateTime           @db.Timestamptz(3)
  endAt              DateTime           @db.Timestamptz(3)
  bufferBeforeMin    Int                @default(0)
  bufferAfterMin     Int                @default(0)
  duration           Int
  price              Float
  status             String             @default("pending")
  notes              String?
  razorpayPaymentId  String?
  razorpayTransferId String? // set when paid out directly via Razorpay Route; excluded from wallet balance
  paymentStatus      String             @default("unpaid")
  paymentMode        String             @default("prepaid")
  reminderSent       Boolean            @default(false)
  /// The customer chose (or the service forces) an online consultation for this booking.
  isOnline           Boolean            @default(false)
  /// A link set on this booking by staff while editing it; beats the service and staff links.
  meetingUrl         String?
  /// Set while status = pending_payment: the slot/token is held until then.
  holdExpiresAt      DateTime?          @db.Timestamptz(3)
  // Token queue (reception screen). queuePosition = order in the open queue (null until the first queue action).
  source             BookingSource      @default(ONLINE)
  queuePosition      Int?
  queueState         QueueState?
  notPresentCount    Int                @default(0)
  servingStartedAt   DateTime?          @db.Timestamptz(3)
  /// The earlier booking this one was carried over from ("Not coming"); at most one carry-over per booking.
  /// Who the appointment is for (a booker can book for others). Null on older bookings: then the contact's name.
  patientName        String?
  /// When reception marked the customer as arrived (slot bookings) or present when called (token). Just a timestamp: the queue keeps its own states.
  arrivedAt          DateTime?
  /// Set when this booking is the free follow-up of an earlier, completed appointment. Unique: one follow-up per appointment.
  followUpOfId       String?            @unique
  followUpOf         Appointment?       @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUp           Appointment?       @relation("FollowUp")
  /// For someone else: how they relate to the booker (child, parent, spouse, other), and (clinic pack) age and gender.
  patientRelation    String?
  patientAge         Int?
  patientGender      String?
  carriedFromId      String?            @unique
  carriedFrom        Appointment?       @relation("CarryOver", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedTo          Appointment?       @relation("CarryOver")
  // Token booking (Business.bookingMode = TOKEN). Numbers are per (tokenSessionId, sessionDate) and never reused.
  tokenSessionId     String?
  sessionDate        DateTime?          @db.Date
  tokenNumber        Int?
  estimatedAt        DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tokenSession       TokenSession?      @relation(fields: [tokenSessionId], references: [id], onDelete: SetNull)
  payments           Payment[]
  credits            CustomerCredit[]
  platformFees       PlatformFeeEntry[]
  service            Service            @relation(fields: [serviceId], references: [id])
  staff              Staff?             @relation(fields: [staffId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id])
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([tokenSessionId, sessionDate, tokenNumber])
  @@index([businessId, date])
  @@index([staffId, date])
  @@index([date, reminderSent])
  @@index([status, holdExpiresAt])
  @@index([businessId, sessionDate, queuePosition])
}

model WithdrawalRequest {
  id          String    @id @default(cuid())
  businessId  String
  amount      Float
  status      String    @default("pending")
  notes       String?
  adminNotes  String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// One browser/phone that agreed to push, for one signed-in user. Deleted on logout, member removal, permission revoke, and when the push service answers 404/410.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
}

/// A user's own choices for phone alerts (all on by default). What they are ALLOWED to receive still comes from their permissions.
model PushPreference {
  userId       String   @id
  newBooking   Boolean  @default(true)
  cancellation Boolean  @default(true)
  reschedule   Boolean  @default(true)
  queue        Boolean  @default(true)
  payment      Boolean  @default(true)
  summary      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Broadcast {
  id         String   @id @default(cuid())
  businessId String
  subject    String?
  message    String
  medium     String
  sentTo     Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  amount      Float
  category    String   @default("Other")
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  title      String
  body       String
  url        String   @default("/dashboard")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model SupportTicket {
  id         String           @id @default(cuid())
  businessId String
  subject    String
  status     String           @default("open")
  priority   String           @default("normal")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderRole String
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String // Markdown
  coverImage     String?
  authorName     String    @default("Calvy Team")
  tags           String    @default("") // comma-separated
  seoTitle       String?
  seoDescription String?
  faq            String    @default("[]") // JSON [{q,a}]
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  businessType  String?
  demoRequested Boolean  @default(false)
  message       String?
  status        String   @default("new") // new | contacted | qualified | demo | won | lost
  source        String   @default("landing")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

enum NotifStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum NotifChannel {
  EMAIL
  WHATSAPP
  PUSH
}

/// One message to one recipient on one channel; also the delivery log (docs/notifications-design.md).
/// No foreign keys: the log outlives hard-deleted appointments. A null businessId is platform mail.
model NotificationOutbox {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  businessId     String?
  appointmentId  String?
  event          String
  audience       String // BUSINESS | CUSTOMER | PLATFORM
  channel        NotifChannel
  recipient      String
  template       String
  payload        Json
  /// Encrypted auth link (lib/notifications/secret.ts), cleared once the row is final. Never raw in payload.
  secret         String?
  status         NotifStatus  @default(PENDING)
  attempts       Int          @default(0)
  error          String?
  providerId     String?
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  lockedUntil    DateTime?    @db.Timestamptz(3)
  expiresAt      DateTime?    @db.Timestamptz(3)
  sentAt         DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
  @@index([appointmentId])
}

/// A recipient who unsubscribed from one business's optional emails. Transactional mail ignores it.
/// No foreign key, like the outbox.
model NotificationOptOut {
  businessId String
  recipient  String // lowercased email
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([businessId, recipient])
}

model EmailLog {
  id            String   @id @default(cuid())
  type          String // confirmation | reminder | cancellation | reschedule | invoice | verification | lead
  to            String
  subject       String
  status        String // sent | failed | skipped
  providerId    String? // Resend message id
  error         String?
  appointmentId String?
  businessId    String?
  createdAt     DateTime @default(now())

  @@index([appointmentId])
  @@index([businessId, createdAt])
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  staffId    String? // null = business hours
  weekday    Int // 0 = Sunday .. 6 = Saturday
  startMin   Int // minutes since local midnight (Business.timezone)
  endMin     Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, staffId, weekday])
}

model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  staffId    String? // null = holiday / closure for the whole business
  startAt    DateTime @db.Timestamptz(3)
  endAt      DateTime @db.Timestamptz(3)
  reason     String   @default("")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startAt])
}

enum PackId {
  CLINIC
  SALON_SPA
  LAWYER
  FITNESS
  CONSULTANT
  OTHER
}

enum BookingMode {
  SLOT
  TOKEN
}

model TokenSession {
  id              String        @id @default(cuid())
  businessId      String
  staffId         String? // null = business-wide queue; set = that staff member's own queue
  name            String
  weekdays        Int[] // 0 = Sunday .. 6 = Saturday
  startMin        Int // minutes since local midnight (Business.timezone)
  endMin          Int
  minutesPerToken Int
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff           Staff?        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([businessId, staffId])
}

enum OnlinePayMode {
  BOOKING_FEE_ONLY
  FULL_ONLINE
}

enum FeePayer {
  CUSTOMER
  BUSINESS
}

enum PayProvider {
  MOCK
  CASHFREE
}

enum PayStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum FeeEntryKind {
  CHARGED
  CARRIED_OVER
  WAIVED
  REFUNDED
}

/// One online payment attempt (a gateway order). Money in minor units (paise / cents).
model Payment {
  id                 String             @id @default(cuid())
  businessId         String
  appointmentId      String?
  provider           PayProvider
  providerOrderId    String             @unique
  amountMinor        Int
  platformFeeMinor   Int
  businessShareMinor Int
  currency           String
  status             PayStatus          @default(CREATED)
  refundedMinor      Int                @default(0)
  method             String?
  paymentRef         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  feeEntries         PlatformFeeEntry[]

  @@index([businessId, createdAt])
  @@index([appointmentId])
}

/// Append-only ledger of Calvy platform fees (never updated or deleted).
model PlatformFeeEntry {
  id            String       @id @default(cuid())
  businessId    String
  appointmentId String?
  paymentId     String?
  kind          FeeEntryKind
  amountMinor   Int
  createdAt     DateTime     @default(now())
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

/// Gateway webhooks already processed (idempotency).
model WebhookEvent {
  id         String      @id @default(cuid())
  provider   PayProvider
  eventId    String
  kind       String
  receivedAt DateTime    @default(now())

  @@unique([provider, eventId])
}

enum ServiceMode {
  IN_PERSON
  ONLINE
  BOTH
}

enum BookingSource {
  ONLINE
  DASHBOARD
  WALK_IN
}

enum QueueState {
  WAITING
  SERVING
  DONE
  NO_SHOW
  MOVED
  CANCELLED
}

enum CreditKind {
  MISSED
  CANCELLED
  USED
  /// Credit spent on a booking that then lapsed, failed or was cancelled: handed back once per booking.
  USED_REVERSED
  REFUND_REMOVED
  ADJUSTMENT
}

/// Append-only wallet ledger per customer per clinic (Client is already per business).
/// Balance = SUM(amountMinor): positive when a missed or cancelled paid booking is credited,
/// negative when credit is used, refunded out, or adjusted. Never expires.
model CustomerCredit {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  kind          CreditKind
  amountMinor   Int
  currency      String
  appointmentId String?
  paymentId     String?
  note          String?
  createdAt     DateTime     @default(now())
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// One credit per booking per cause: a repeated queue action can never credit twice.
  @@unique([appointmentId, kind])
  @@index([businessId, clientId])
}

/// A customer account (email + password), separate from business-owner User accounts. Bookings are
/// linked by VERIFIED email only: nothing is shown until emailVerified is set.
model Customer {
  id                String          @id @default(cuid())
  name              String
  /// Lowercased.
  email             String          @unique
  /// Null for an account created automatically at booking, until the emailed setup link sets it.
  password          String?
  /// Google account id (profile.sub); set by a verified Google sign-up or an explicit "Link Google" while logged in. Never linked silently by email.
  googleId          String?         @unique
  emailVerified     DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tokens            CustomerToken[]
}

/// Single-use emailed links for customers (purpose "verify" or "reset"); only the hash is stored.
model CustomerToken {
  id         String    @id @default(cuid())
  customerId String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
}

/// A team login for one business (separate from bookable Staff). One login = one business.
/// Owner-only areas are never stored here, so they can never be granted.
model TeamMember {
  id          String       @id @default(cuid())
  businessId  String
  /// Normalised email, unique across all businesses.
  email       String       @unique
  name        String
  /// Free-text label (Receptionist, Doctor...). Display only.
  roleName    String
  permissions String[]     @default([])
  /// Optional link to a bookable staff record; scopes "own only" appointment access.
  staffId     String?
  /// Set when the invite is accepted. Deleting the member also deletes this user.
  userId      String?      @unique
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  invites     TeamInvite[]

  @@index([businessId])
}

model TeamInvite {
  id        String     @id @default(cuid())
  memberId  String
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime   @default(now())
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  actorId    String
  action     String
  target     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

/// One signed-in admin browser session: 2FA state, idle timeout and the current view-as. The cookie holds a random token; only its hash is stored.
model AdminSession {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  /// Idle timeout: 30 minutes after this.
  lastSeenAt        DateTime  @default(now())
  /// Last fresh TOTP check: sensitive actions need it within 5 minutes.
  reauthAt          DateTime
  endedAt           DateTime?
  viewAsBusinessId  String?
  /// "READ" or "ACT".
  viewAsMode        String?
  viewAsReason      String?
  viewAsStartedAt   DateTime?
  viewAsExpiresAt   DateTime?
  /// The AdminAuditLog row that opened this view-as, so the end row can be linked.
  viewAsAuditId     String?

  @@index([userId])
}

/// Everything a Calvy admin does, plus view-as sessions. APPEND-ONLY: a database trigger refuses UPDATE and DELETE.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  businessId String?
  reason     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([action, createdAt])
}
